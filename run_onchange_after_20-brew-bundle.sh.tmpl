#!/bin/sh
#
# Reconcile installed packages against the Brewfiles.
#
# The hashes below are what make this fire: the script body never changes when
# a Brewfile does, so without them chezmoi would see identical contents and
# skip the run. Both files are hashed, so editing either one re-runs this.
#
# Brewfile hash:      {{ include "Brewfile" | sha256sum }}
# Brewfile.work hash: {{ include "Brewfile.work" | sha256sum }}

set -e

[ "$(uname)" = "Darwin" ] || exit 0

# A cask that exists at the destination but was not installed by Homebrew only
# adopts when the two versions match exactly, so conflicts are expected and
# should not abort the rest of the apply. brew bundle continues past individual
# failures and reports at the end; report that and carry on.
bundle() {
  echo "› brew bundle$2"
  # --no-upgrade keeps this to installing what is missing. Upgrading everything
  # outdated is a separate, deliberate `brew upgrade`, not a side effect of
  # editing the package list.
  if ! HOMEBREW_CASK_OPTS="--adopt" brew bundle install --no-upgrade --file="$1"; then
    echo "  ! some packages did not install; see above"
  fi
}

bundle "{{ .chezmoi.sourceDir }}/Brewfile"

# Work-only packages. The marker is a plain file rather than chezmoi data, so
# the repo keeps zero templates and `chezmoi re-add` stays universal.
if [ -f "$HOME/.config/dotfiles-work" ]; then
  bundle "{{ .chezmoi.sourceDir }}/Brewfile.work" " (work)"
fi
