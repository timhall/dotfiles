#!/bin/sh
#
# Reconcile installed packages against the Brewfile.
#
# The hash below is what makes this fire: the script body never changes when
# the Brewfile does, so without it chezmoi would see identical contents and
# skip the run.
#
# Brewfile hash: {{ include "Brewfile" | sha256sum }}

set -e

[ "$(uname)" = "Darwin" ] || exit 0

# --no-upgrade keeps this to installing what is missing. Upgrading everything
# outdated is a separate, deliberate `brew upgrade`, not a side effect of
# editing the package list.
echo "› brew bundle"
HOMEBREW_CASK_OPTS="--adopt" brew bundle install --no-upgrade \
  --file="{{ .chezmoi.sourceDir }}/Brewfile"
