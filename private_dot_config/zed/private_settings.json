// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "cli_default_open_behavior": "new_window",
  "diff_view_style": "split",
  "project_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
    "typescript-language-server": {
      "initialization_options": {
        "maxTsServerMemory": 8192,
      },
    },
  },
  "agent_servers": {
    "claude-acp": {
      "favorite_config_option_values": {
        "mode": [
          "auto"
        ]
      },
      "default_config_options": {
        "fast": true,
        "effort": "high",
        "model": "default",
        "mode": "auto",
      },
      "type": "registry",
    },
    "codex-acp": {
      "default_config_options": {
        "fast-mode": true
      },
      "type": "registry",
    },
  },
  "agent": {
    "thinking_display": "always_collapsed",
    "dock": "left",
    "tool_permissions": {
      "default": "allow",
    },
    "default_profile": "write",
    "profiles": {
      "write": {
        "name": "Write",
        "tools": {
          "search_web": true,
          "copy_path": true,
          "create_directory": true,
          "create_file": true,
          "delete_path": true,
          "diagnostics": true,
          "edit_file": true,
          "fetch": true,
          "list_directory": true,
          "move_path": true,
          "now": true,
          "find_path": true,
          "read_file": true,
          "grep": true,
          "terminal": true,
          "thinking": true,
        },
        "enable_all_context_servers": true,
        "context_servers": {},
      },
    },
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4",
    },
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4",
    },
  },
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
  },
  "theme": {
    "mode": "system",
    "light": "GitHub Light",
    "dark": "GitHub Dark",
  },
  "buffer_font_size": 12.0,
  "buffer_font_features": {
    "calt": false,
  },
  "soft_wrap": "bounded",
  "preferred_line_length": 120,
  "format_on_save": "on",
  "formatter": "prettier",
  "languages": {
    "TypeScript": {
      "language_servers": ["vtsls"],
    },
    "TSX": {
      "language_servers": ["vtsls"],
    },
    "JavaScript": {
      "language_servers": ["vtsls"],
    },
  },
  "minimap": {
    "show": "auto",
  },
  "tab_size": 2,
}
