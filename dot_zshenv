#
# User Environment
#

# (handled in .zprofile for interactive shells only)

#
# PATH (shared across interactive + non-interactive / agent shells)
#

# Homebrew
export HOMEBREW_PREFIX="/opt/homebrew"
export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
export HOMEBREW_REPOSITORY="/opt/homebrew"
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin${PATH+:$PATH}"
export MANPATH="/opt/homebrew/share/man${MANPATH+:$MANPATH}:"
export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"

# Scripts, skills, and projects
export PATH="$PATH:$HOME/dev/scripts/bin:$HOME/dev/timhall/skills/bin:$HOME/dev/scratch/project-guide/packages/cli/dist"

# roc
export PATH="$PATH:$HOME/dev/installs/roc_nightly"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# deno
export DENO_INSTALL="$HOME/.deno"
export PATH="$DENO_INSTALL/bin:$PATH"

# pyenv (shims + bin so python is resolvable non-interactively; `pyenv init -` stays in .zshrc)
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/shims:$PYENV_ROOT/bin:$PATH"

# fnm — resolve the binary, then load default node for non-interactive shells too
export PATH="$HOME/Library/Application Support/fnm:$PATH"
command -v fnm >/dev/null && eval "$(fnm env --shell zsh)"

# claude / local bin
export PATH="$HOME/.local/bin:$PATH"

# obsidian
export PATH="$PATH:/Applications/Obsidian.app/Contents/MacOS"

#
# Tool Environment
#

. "$HOME/.cargo/env"

# Vite+ bin (https://viteplus.dev)
. "$HOME/.vite-plus/env"
